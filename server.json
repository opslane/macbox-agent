{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.opslane/macbox",
  "title": "macbox",
  "description": "A real Mac for your agent: build, test, run, and tap through iOS apps on the simulator.",
  "repository": {
    "url": "https://github.com/opslane/macbox-agent",
    "source": "github"
  },
  "websiteUrl": "https://macbox.build",
  "version": "0.6.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "macbox",
      "version": "0.6.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "MACBOX_API_KEY",
          "description": "Your macbox API key (mbx_...). Optional if you ran `macbox login`.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
